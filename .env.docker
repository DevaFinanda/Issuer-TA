# Environment Variables untuk Docker Compose
# Copy file ini ke .env untuk konfigurasi lokal

# Issuer DID Configuration
ISSUER_PRIVATE_KEY=your-private-key-hex-here
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# API Security
API_KEY=your-secure-api-key-change-this-in-production
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Session Secret
SESSION_SECRET=your-session-secret-change-this-in-production
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# Database Configuration (sudah dikonfigurasi di docker-compose.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=Deva123
# POSTGRES_DB=issuer_db

# Ports (optional, default values)
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
# POSTGRES_PORT=5432
