// Prisma Schema — Synced with backend schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MODEL — Admin & Holder
// ============================================
model User {
  id            String     @id @default(uuid())
  username      String?    @unique
  email         String     @unique
  passwordHash  String
  fullName      String

  // Holder-specific fields (OID4VCI)
  nik           String?    @unique
  nama          String?
  tanggalLahir  DateTime?

  // Role & Type
  userType      UserType   @default(ADMIN)
  role          UserRole   @default(ADMIN)
  isActive      Boolean    @default(true)

  // Session & Security
  lastLoginAt   DateTime?
  loginAttempts Int        @default(0)
  lockedUntil   DateTime?

  // Timestamps
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  auditLogs          AuditLog[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  credentials        Credential[]

  @@index([username])
  @@index([email])
  @@index([nik])
  @@index([isActive])
  @@map("users")
}

// ============================================
// AUTHORIZATION CODE — OID4VCI Auth Code Flow
// ============================================
model AuthorizationCode {
  code        String   @id @unique
  userId      String
  clientId    String
  redirectUri String
  state       String?
  used        Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("authorization_codes")
}

// ============================================
// ACCESS TOKEN — OID4VCI Token Exchange
// ============================================
model AccessToken {
  token     String   @id @unique
  userId    String
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("access_tokens")
}

// ============================================
// CREDENTIAL — Issued Verifiable Credentials
// ============================================
model Credential {
  id                  String           @id @default(uuid())
  credentialJwt       String?          @db.Text
  credentialOfferUri  String?
  format              String           @default("jwt_vc_json")

  holderDID           String?
  holderName          String
  nik                 String
  nama                String
  tanggalLahir        String?

  issuerDID           String
  issuerName          String           @default("Identity Credential Issuer")

  metadata            Json?

  issuedAt            DateTime         @default(now())
  validFrom           DateTime         @default(now())
  validUntil          DateTime

  status              CredentialStatus @default(OFFERED)
  claimedAt           DateTime?
  revokedAt           DateTime?
  revokedReason       String?

  userId              String?
  user                User?            @relation(fields: [userId], references: [id])

  @@index([holderDID])
  @@index([nik])
  @@index([status])
  @@index([issuedAt])
  @@index([userId])
  @@map("credentials")
}

// ============================================
// CREDENTIAL OFFER
// ============================================
model CredentialOffer {
  id         String   @id @default(uuid())
  offerData  Json
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@map("credential_offers")
}

// ============================================
// SUPPORTING MODELS
// ============================================
model RevocationList {
  id           String   @id @default(uuid())
  credentialId String   @unique
  revokedAt    DateTime @default(now())
  reason       String?
  revokedBy    String?

  @@index([credentialId])
  @@map("revocation_list")
}

model AuditLog {
  id         String      @id @default(uuid())
  action     AuditAction
  entityType String
  entityId   String?
  actorType  String
  actorId    String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyHash     String    @unique
  permissions String[]  @default(["read"])
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([keyHash])
  @@index([isActive])
  @@map("api_keys")
}

model IssuerConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("issuer_config")
}

// ============================================
// ENUMS
// ============================================
enum UserType {
  ADMIN
  HOLDER
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum CredentialStatus {
  OFFERED
  ACTIVE
  REVOKED
  EXPIRED
  SUSPENDED
}

enum AuditAction {
  CREDENTIAL_ISSUED
  CREDENTIAL_RETRIEVED
  CREDENTIAL_REVOKED
  CREDENTIAL_VERIFIED
  CREDENTIAL_OFFER_CREATED
  AUTHORIZATION_CODE_ISSUED
  TOKEN_ISSUED
  API_KEY_CREATED
  API_KEY_REVOKED
  CONFIG_UPDATED
  SYSTEM_ERROR
  USER_REGISTERED
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_UPDATED
  USER_DELETED
}
