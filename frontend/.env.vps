# ==============================================
# KONFIGURASI FRONTEND UNTUK VPS (202.155.132.71)
# ==============================================

# API Configuration - Mengarah ke backend VPS
# NEXT_PUBLIC_* di-bake saat build, harus ada SEBELUM `next build`
NEXT_PUBLIC_API_URL=http://202.155.132.71:3001
NEXT_PUBLIC_API_KEY=your-very-secure-api-key-here-use-64-char-random-string

# Database - Diperlukan untuk auth (login/register) di API routes
DATABASE_URL=postgresql://issuer_user:your_password@localhost:5432/issuer_db

# JWT Secret - Untuk authentication
JWT_SECRET=your-jwt-secret-change-this-in-production

# Server Config (untuk standalone mode)
PORT=3000
HOSTNAME=0.0.0.0

# ==============================================
# CARA SETUP DI VPS:
# ==============================================
# 1. Copy file ini: cp .env.vps .env.local
# 2. Edit NEXT_PUBLIC_API_KEY sesuai dengan ADMIN_API_KEY di backend
# 3. Edit DATABASE_URL sesuai konfigurasi PostgreSQL
# 4. Edit JWT_SECRET dengan random string yang aman
# 5. Build frontend: pnpm build
# 6. Fix standalone: bash ~/fix-standalone.sh
# 7. Atau jalankan: bash ~/build-vps.sh
