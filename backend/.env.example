# Database Connection (GANTI DENGAN VPS ANDA!)
DATABASE_URL="postgresql://issuer_user:YOUR_PASSWORD@YOUR_VPS_IP:5432/issuer_db?schema=public&sslmode=require"

# Server Configuration
PORT=3001
NODE_ENV=production

# DID Configuration
ISSUER_NAME=BPJS Kesehatan
ISSUER_DOMAIN=202.155.132.71:3001
ISSUER_BASE_URL=http://202.155.132.71:3001
PRIVATE_KEY_HEX=your-private-key-hex-here

# Security Configuration
ADMIN_API_KEY=your-very-secure-api-key-here-use-64-char-random-string
# Frontend origins yang diizinkan akses backend (pisahkan dengan koma, tanpa spasi)
ALLOWED_ORIGINS=http://202.155.132.71:3000,http://202.155.132.71
BASE_URL=http://202.155.132.71:3001

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
