# Database Connection
DATABASE_URL="postgresql://issuer_user:YOUR_PASSWORD@YOUR_VPS_IP:5432/issuer_db?schema=public&sslmode=require"

# Server Configuration
PORT=3001
NODE_ENV=production

# Issuer Configuration
ISSUER_NAME=Identity Credential Issuer
ISSUER_DOMAIN=202.155.132.71.nip.io
ISSUER_BASE_URL=https://202.155.132.71.nip.io
PRIVATE_KEY_HEX=your-private-key-hex-here

# Frontend URL (for OID4VCI authorize redirect)
FRONTEND_URL=https://202.155.132.71.nip.io

# Security Configuration
ADMIN_API_KEY=your-very-secure-api-key-here-use-64-char-random-string
ALLOWED_ORIGINS=https://202.155.132.71.nip.io,http://localhost:3000
BASE_URL=https://202.155.132.71.nip.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
