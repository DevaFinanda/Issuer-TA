{
  "name": "issuer-bpjs-oid4vci",
  "version": "2.0.0",
  "description": "BPJS Archive Issuer - OpenID4VCI Compliant with Credo Standard",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup": "tsx src/setup.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:connection": "node test-connection.js",
    "vps:setup": "pwsh -File setup-vps.ps1",
    "vps:migrate": "pwsh -File migrate-to-vps.ps1"
  },
  "keywords": [
    "SSI",
    "DID Web",
    "Verifiable Credentials",
    "BPJS",
    "PostgreSQL"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@credo-ts/askar": "0.6.2",
    "@credo-ts/core": "0.6.2",
    "@credo-ts/node": "0.6.2",
    "@credo-ts/openid4vc": "0.6.2",
    "@openwallet-foundation/askar-nodejs": "0.6.0",
    "@prisma/client": "^5.22.0",
    "@sd-jwt/core": "^0.17.0",
    "@sd-jwt/types": "^0.17.0",
    "@sd-jwt/utils": "^0.17.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "did-jwt": "^8.0.4",
    "did-jwt-vc": "^4.0.4",
    "did-resolver": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.3",
    "web-did-resolver": "^2.0.27"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@openwallet-foundation/askar-nodejs",
      "koffi"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@openwallet-foundation/askar-shared": ">=0.4.3"
      }
    }
  }
}
